# keygate-server ----------------------------------------------------------------
# Copy to .env and fill in. `KEYGATE_*` names are read by src/config.ts.

# Soroban RPC endpoint used for event ingestion (`getEvents`).
KEYGATE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed keygate contracts (see keygate-contracts for deployment steps).
# These three are structurally valid strkeys but unassigned addresses, so the
# service boots and fails on the RPC rather than on the config.
KEYGATE_CORE_CONTRACT=CAAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQC526
KEYGATE_POLICY_CONTRACT=CABAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAFNSZ
KEYGATE_BREAKER_CONTRACT=CABQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGAYDAMBQGCK3

# Decisions fail closed once the mirror is older than this many seconds.
KEYGATE_MAX_STALENESS_SECONDS=120
KEYGATE_SYNC_INTERVAL_MS=5000
KEYGATE_SYNC_PAGE_SIZE=100

# Optional cold-start replay ledger. Soroban RPC retains only a limited window
# of history, so a fresh deployment usually wants the latest ledger instead.
# KEYGATE_START_LEDGER=

KEYGATE_PORT=8080
KEYGATE_LOG_LEVEL=info

# Optional. When set, every /v1/decide response carries an HMAC-SHA256 signature
# in `x-keygate-signature` that callers can verify with keygate-client.
# Generate one with: openssl rand -hex 32
# KEYGATE_SIGNING_KEY=
